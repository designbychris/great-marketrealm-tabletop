msgstr "Desfazer Último"

msgid "Until Next Time…"
msgstr "Até à Próxima…"

msgid "Until next time — this Session has concluded."
msgstr "Até à próxima — esta Sessão terminou."

msgid "Use Monster Threshold"
msgstr "Usar Ponto de Posicionamento de Monstros"

msgid "Username or email"
msgstr "Nome de utilizador ou email"

