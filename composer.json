{
  "name": "great-marketrealm/great-marketrealm-tabletop",
  "description": "Virtual tabletop for The Great Marketrealm.",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "GreatMarketrealmTabletop\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "GreatMarketrealmTabletop\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --display-warnings"
  },
  "config": {
    "sort-packages": true
  }
}
